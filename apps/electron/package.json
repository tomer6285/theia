{
  "name": "@dion/electron",
  "version": "0.1.0",
  "description": "Dion Site and Webapp",
  "homepage": "https://github.com/tomer6285/dion-tc",
  "author": "Tomer Chalabi <tomerchalabi@gmail.com>",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:linux:x64": "electron-builder --linux --x64",
    "dist:linux:arm64": "electron-builder --linux --arm64",
    "dist:linux:all": "electron-builder --linux --x64 --arm64",
    "dist:mac": "electron-builder --mac",
    "dist:mac:all": "electron-builder --mac --x64 --arm64 --universal",
    "dist:win": "electron-builder --win",
    "dist:win:all": "electron-builder --win --x64 --arm64",
    "dist:all": "electron-builder -mwl --x64 --arm64",
    "dist:dir": "electron-builder --dir",
    "dist:dir:arm64": "electron-builder --dir --arm64",
    "dist:dir:x64": "electron-builder --dir --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.dion.touch",
    "productName": "Dion Touch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../web/dist/**/*"
    ],
    "linux": {
      "maintainer": "Tomer Chalabi <tomerchalabi@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Video"
    },
    "deb": {
      "packageName": "dion-touch",
      "artifactName": "dion-touch_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
