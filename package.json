{
  "name": "theia-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run && node --test scripts/toolchain.test.cjs",
    "lint": "pnpm typecheck",
    "build:electron": "pnpm --filter @theia/web build && pnpm --filter @theia/electron build",
    "dist:electron": "pnpm build:electron && pnpm --filter @theia/electron dist",
    "dist:electron:linux": "pnpm build:electron && pnpm --filter @theia/electron dist:linux",
    "dist:electron:linux:x64": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:x64",
    "dist:electron:linux:arm64": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:arm64",
    "dist:electron:linux:all": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:all",
    "dist:electron:linux:rpm": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:rpm",
    "dist:electron:linux:rpm:x64": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:rpm:x64",
    "dist:electron:linux:rpm:arm64": "pnpm build:electron && pnpm --filter @theia/electron dist:linux:rpm:arm64",
    "dist:electron:win": "pnpm build:electron && pnpm --filter @theia/electron dist:win",
    "dist:electron:win:all": "pnpm build:electron && pnpm --filter @theia/electron dist:win:all",
    "dist:electron:mac": "pnpm build:electron && pnpm --filter @theia/electron dist:mac",
    "dist:electron:mac:all": "pnpm build:electron && pnpm --filter @theia/electron dist:mac:all",
    "start:electron": "pnpm --filter @theia/electron start",
    "typecheck": "turbo run typecheck",
    "assets:mobile": "node scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
